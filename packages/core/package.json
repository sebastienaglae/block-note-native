{
  "name": "@sebastienaglae/bnn-core",
  "version": "0.7.3",
  "description": "Platform-agnostic block-editor engine: document model, schema, transforms, history, markdown.",
  "license": "MIT",
  "author": "Sébastien Aglaé",
  "homepage": "https://github.com/sebastienaglae/block-note-native/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/sebastienaglae/block-note-native/issues"
  },
  "keywords": [
    "block-editor",
    "rich-text",
    "notion",
    "blocknote",
    "editor",
    "markdown",
    "typescript"
  ],
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienaglae/block-note-native.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  }
}
