{
  "name": "@sebastienaglae/bnn-react",
  "version": "0.6.0",
  "description": "Cross-platform (web + React Native) UI for the block editor: blocks, slash menu, toolbar, page tree, comments, custom components, i18n, icons.",
  "license": "MIT",
  "author": "Sébastien Aglaé",
  "homepage": "https://github.com/sebastienaglae/block-note-native/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/sebastienaglae/block-note-native/issues"
  },
  "keywords": [
    "block-editor",
    "rich-text",
    "notion",
    "blocknote",
    "react",
    "react-native",
    "react-native-web",
    "editor"
  ],
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienaglae/block-note-native.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sebastienaglae/bnn-core": "0.6.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": "*",
    "lucide-react": "*",
    "lucide-react-native": "*",
    "react-native-svg": "*",
    "react-native-webview": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  }
}
